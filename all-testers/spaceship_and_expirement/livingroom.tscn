[node name="sample2" type="Label" parent="PanelContainer" unique_id=2080230967]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_fonts/font = ExtResource("1_eef5v")
theme_override_font_sizes/font_size = 35
text = "Sample Type: Mojave Mars Simulant (MMS)
Particle size:  1 µm up to 1,000 µm 
Contains: Basalt 
Mined from:  Boron, California, Western Mojave Desert

FURTHER DATA = 
2 types, MMS Sand and MMS Dust.
It was revised to make MMS-2, produced by The Martian Garden
in aims for a closer match. (0.3 µm  to 0.18 µm)
Performed poorly due to hygroscopic tendencies."
vertical_alignment = 1

[node name="sample3" type="Label" parent="PanelContainer" unique_id=1857671017]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_fonts/font = ExtResource("1_eef5v")
theme_override_font_sizes/font_size = 35
text = "Sample Type: Mars Global Simulant (MGS-1)
Particle size: ~90 µm.
Contains: Plagioclase-rich components, Pyroxene, etc.
Mined from: Synthetic Mineral (Man-made)

FURTHER DATA = 
Based on the Rocknest soil in Gale crater on Mars that 
has been analyzed extensively by the NASA Curiosity rover.
Devoloped by EXOLITH LAB at the University of Central 
Florida."
vertical_alignment = 1

[node name="sample1" type="Label" parent="PanelContainer" unique_id=748148551]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_fonts/font = ExtResource("1_eef5v")
theme_override_font_sizes/font_size = 35
text = "Sample Type: JSC Mars-1 and JSC Mars-1A (Mars Soil Stimulant)
Particle size: <1mm
Contains: Palagonitic tephra, glassy volcanic ash
Mined from:  Pu'u Nene Cinder Cone, Hawaii

FURTHER DATA = 
Samples PH-1 to PH-4 showcase most similarity to regoliath.
Tests show that the maximum compressive and flexural 
strength of the 'martian' geopolymer is comparable to that 
of common clay bricks."
vertical_alignment = 1

